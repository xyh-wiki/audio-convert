:3000 {
  # 固定处理顺序，避免 `try_files` 先将 /healthz 重写到 SPA 入口。
  route {
    encode gzip

    header {
      Cross-Origin-Opener-Policy "same-origin"
      Cross-Origin-Embedder-Policy "require-corp"
      X-Content-Type-Options "nosniff"
      Referrer-Policy "strict-origin-when-cross-origin"
    }

    respond /healthz "ok" 200

    # Keep the assistant same-origin so the FFmpeg.wasm COOP/COEP isolation
    # remains valid. The upstream is the operator-controlled shared Bot.
    @assistant {
      path /assistant/*
    }
    header @assistant {
      X-Robots-Tag "noindex, nofollow, noarchive"
    }
    handle_path /assistant/* {
      reverse_proxy https://bot.xyh.wiki {
        header_up Host bot.xyh.wiki
        # The browser reaches this route on the Audio Convert origin. Preserve
        # that trusted same-origin context across the second reverse proxy.
        header_up Sec-Fetch-Site same-origin
      }
    }

    root * /app/dist

    @wasm {
      path *.wasm
    }
    header @wasm {
      Content-Type "application/wasm"
    }

    @worker {
      path *.worker.js
    }
    header @worker {
      Content-Type "application/javascript"
    }

    @versioned {
      path /assets/*
    }
    header @versioned {
      Cache-Control "public, max-age=31536000, immutable"
    }

    @html {
      path *.html
    }
    header @html {
      Cache-Control "no-cache, no-store, must-revalidate"
    }

    try_files {path} /index.html
    file_server
  }
}
